# --- App ---
APP_NAME=Apna Dastarkhuaan
ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dastarkhuaan

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# --- Image storage (Cloudinary). Leave blank to use local-disk storage in dev. ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (fill in when going live) ---
EASYPAISA_MERCHANT_ID=
EASYPAISA_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_SECRET=
STRIPE_SECRET_KEY=

# --- Local storage fallback ---
LOCAL_STORAGE_DIR=uploads
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/uploads
